# ==========================================================
# Raj Healthcare - Environment Variables Template
# ==========================================================

# 1. Supabase (Database & Authentication)
# Obtain from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# 2. Resend (Transactional Email Service)
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Raj Healthcare <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL="admin@yourdomain.com"

# 3. Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
