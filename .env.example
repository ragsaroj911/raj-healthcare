# ==========================================================
# AuraBook Appointment Booking System - Environment Variables
# ==========================================================

# 1. Supabase (Database & Authentication)
# Obtain these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. Resend (Email Notifications & Confirmations)
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="AuraBook <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL="admin@yourdomain.com"

# 3. Application Domain & URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

